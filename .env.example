# ── Neon Postgres (https://console.neon.tech → your project → Connection string) ──
# Use the pooled connection string. Without it, ZeroCRM runs on built-in demo data.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ── Clerk (https://dashboard.clerk.com → API keys) ──
# With both keys set, every CRM page requires sign-in. Without them, ZeroCRM is an open demo.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
